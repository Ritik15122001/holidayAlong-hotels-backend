# Copy to .env and fill in real values. Never commit .env.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/hotel_enquiry
ADMIN_USER=admin
ADMIN_PASS=change-me
# Signs customer login tokens. Generate with: openssl rand -hex 24
USER_JWT_SECRET=change-me

# Optional: enables live Google ratings on hotels that have a Place ID
# GOOGLE_MAPS_API_KEY=

# Public base URL, used when building upload links (no trailing slash)
# PUBLIC_URL=https://www.htlr.holidayalong.com

# Optional: automatic booking mail to the hotel. Leave SMTP_HOST blank and
# bookings still save normally, they just are not emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bookings@holidayalong.com
# SMTP_PASS=
# MAIL_FROM=HolidayAlong <bookings@holidayalong.com>
# Copy every booking mail to your own inbox
# MAIL_BCC=holidayalong@gmail.com

# Signs staff (Editor / Super Admin) sessions for the admin panel.
# Generate with: openssl rand -hex 24
# ADMIN_JWT_SECRET=change-me

# Minutes a staff session may sit idle before another device may sign in.
# Stops a closed browser locking the account out. Default 20.
# ADMIN_IDLE_MINUTES=20
